<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================================================================
         Permissions

         Plugins (flutter_background_geolocation, firebase_messaging,
         flutter_local_notifications) merge in permissions of their own. What
         is declared here is what RoadPack itself depends on, stated
         explicitly so the requirement is visible in review rather than
         inherited invisibly through a manifest merge.
         ==================================================================== -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location. Coarse is listed alongside fine because Android 12+ lets the
         user grant only approximate location, and the app must still function
         (degraded, and honest about it) in that case. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Background location is the core of the product: a crash is detected
         and a non-arrival is noticed while the app is not on screen.
         NOTE: this permission requires a Google Play prominent-disclosure
         declaration and review before the app can be published (PRD FR-006,
         Phase 0 compliance runway). Declaring it here does not satisfy that. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service for the tracking session. FOREGROUND_SERVICE_LOCATION
         is required from Android 14 (API 34); without it the service throws at
         start on new devices. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications. Runtime-requested from Android 13 (API 33). A denial is
         a degraded state, not a crash: the bystander notification is the only
         path to the bystander screen, so the app must tell the user plainly
         what they lose rather than failing silently. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- On-device activity recognition, used to start and stop trips without
         holding GPS continuously (FR-030). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Resume tracking after a reboot; a phone that restarts mid-commute must
         not silently stop protecting the rider. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="RoadPack"
        tools:replace="android:label"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Pack share links (TRD 7.3). A rider who taps a share link,
                 installs the app and signs in must land back on the claim
                 screen still holding their token; the router preserves it
                 across the sign-in bounce.

                 The custom scheme works without domain ownership. The https
                 filter below needs a real host and an assetlinks.json served
                 from it before it will verify — fill in the host and remove
                 the comment when the domain exists. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="roadpack" android:host="pack" />
            </intent-filter>
            <!--
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="REPLACE_WITH_HOST"
                      android:pathPrefix="/p" />
            </intent-filter>
            -->
        </activity>

        <!-- Google Maps. The key is kept out of source control: see
             android/app/src/main/res/values/google_maps_api.xml, which is
             gitignored and must be created from its .example sibling. Without
             a key the map renders blank  —  it fails quietly, so check here
             first if tiles do not appear. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />

        <!-- Default channel for FCM notifications that arrive while the app is
             not running. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="roadpack_incidents" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Android 11+ package visibility. Without these the app cannot see which
         app would handle a dial or a map intent, so the bystander screen's
         "Call 112" and "Directions" buttons resolve to nothing  —  the exact
         failure that matters most, on the screen that matters most. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
